# Schema-First Interface Protocol (SFIP) Markup Format v0.1
# File extension: .sfip
# Purpose: Encode S-Objects and their relations in a lightweight, human-readable, machine-parsable format
# Syntax inspired by YAML for readability, with semantic rigor for logic

# Schema Metadata
schema:
  id: "uuid:8d4e7a1b-9c2f-4e3a-b5d7-6f8a9c0d1e2f"
  title: "Example Cognitive Blueprint"
  author: "Anonymous Thinker"
  created: "2025-05-11T14:30:00Z"
  domain: "Epistemic Modeling"

# S-Objects (Atomic Cognitive Units)
s_objects:
  - type: definition_block
    id: def_001
    name: "Causal Nexus"
    description: "A point where multiple causal chains converge to produce an outcome."
    attributes:
      - scope: "system-wide"
      - determinism: "probabilistic"

  - type: concept_node
    id: node_001
    label: "Feedback Amplifier"
    properties:
      - strength: "0.7"
      - delay: "200ms"
    links:
      - target: def_001
        relation: "depends_on"

  - type: affordance_map
    id: aff_001
    name: "System Interaction Points"
    actions:
      - action: "query_state"
        description: "Retrieve current system state."
      - action: "modify_param"
        description: "Adjust feedback strength."
    constraints:
      - gate: gate_001
        condition: "user_role == admin"

  - type: gate_condition
    id: gate_001
    name: "Admin Access"
    condition: "user_role == admin"
    effect: "allow"

  - type: feedback_loop
    id: loop_001
    name: "Stabilization Cycle"
    input: node_001
    output: aff_001
    modifier: "exponential_decay"
    parameters:
      - rate: "0.05"

  - type: lattice_link
    id: link_001
    source: node_001
    target: def_001
    relation: "causal"
    strength: "0.9"

# Interaction Modes Configuration
interaction_modes:
  construct:
    enabled: true
    format: "visual_graph"
  glance:
    enabled: true
    default_view: "hierarchy"
  inspect:
    enabled: true
    metadata_fields: ["id", "description", "links"]
  simulate:
    enabled: false
    engine: null

# Export Layers
export_layers:
  - type: code
    format: "json_schema"
    enabled: true
  - type: semantic_map
    format: "graphml"
    enabled: true
  - type: narrative
    enabled: false
    warning: "Narrative export requires explicit opt-in."

# End of Schema


