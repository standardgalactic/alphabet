 6.01057 5.53708 6.00551 6.00391 6.00391C6.00551 5.53708 6.01057 5.14051 6.03809 4.80371C6.0755 4.34588 6.15483 3.94012 6.34668 3.56348L6.46875 3.34473C6.77282 2.84912 7.20856 2.44514 7.72949 2.17969L7.87207 2.11328C8.20855 1.96886 8.56979 1.90385 8.9707 1.87109C9.42091 1.83432 9.978 1.83496 10.667 1.83496H13.5C14.1891 1.83496 14.746 1.83431 15.1963 1.87109C15.6541 1.90851 16.0599 1.98788 16.4365 2.17969L16.6553 2.30176C17.151 2.60585 17.5548 3.04244 17.8203 3.56348L17.8867 3.70606C18.031 4.04235 18.0962 4.40306 18.1289 4.80371C18.1657 5.25395 18.165 5.81091 18.165 6.5V9.33301Z"></path></svg>Copy code</button></div></div></div><div class="overflow-y-auto p-4" dir="ltr"><code class="whitespace-pre! language-verilog"><span>// N must be power of two, N = 2**K
module muxN_w
  #( parameter N = 8,         // number of inputs
     parameter W = 16 )       // data width
  (
   input  wire [$clog2(N)-1:0] sel,
   input  wire [N-1:0][W-1:0]  din, // SystemVerilog packed array; if plain Verilog, flatten
   output wire [W-1:0]         dout
  );

  // bit-slice approach: instantiate W single-bit N:1 muxes conceptually
  genvar b;
  generate
    for (b = 0; b &lt; W; b = b + 1) begin : bitslice
      // select among din[i][b] for all i
      // implement as reduction using case
      reg d_out;
      integer i;
      always @(*) begin
        d_out = 'bx;
        case (sel)
          // explicit cases:
          // for synthesis, more idiomatic to index din[sel][b]
        endcase
      end
      assign dout[b] = din[sel][b]; // simpler and synthesizable
    end
  endgenerate

endmodule
</span></code></div></div></pre>
<p data-start="4896" data-end="5045">Note: In real Verilog/SystemVerilog, you can write <code data-start="4947" data-end="4965">dout = din[sel];</code> if din is declared as a 2-D packed array; synthesis tools will emit a mux tree.</p>
<h3 data-start="5047" data-end="5089">(b) Compact behavioral (synthesizable)</h3>
