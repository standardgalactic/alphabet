<span class="line"><span style="color: rgb(197, 134, 192);">\usepackage</span><span style="color: rgb(230, 230, 230);">{</span><span style="color: rgb(78, 201, 176);">booktabs</span><span style="color: rgb(230, 230, 230);">} </span><span style="color: rgb(106, 153, 85);">% For better tables</span></span>
