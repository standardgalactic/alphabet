<span class="line"><span style="color: rgb(220, 220, 170);">\subsection</span><span style="color: rgb(230, 230, 230);">{Futarchy-Inspired Policy Selection}</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(230, 230, 230);">Let </span><span style="color: rgb(78, 201, 176);">$</span><span style="color: rgb(86, 156, 214);">\Phi</span><span style="color: rgb(78, 201, 176);">_{\text{target}}</span><span style="color: rgb(78, 201, 176);">$</span><span style="color: rgb(230, 230, 230);"> be the desired outcome. Policy impact: </span><span style="color: rgb(78, 201, 176);">$</span><span style="color: rgb(86, 156, 214);">\Delta</span><span style="color: rgb(86, 156, 214);"> \Phi</span><span style="color: rgb(78, 201, 176);">_{\mathcal{P}}(x) = </span><span style="color: rgb(86, 156, 214);">\Phi</span><span style="color: rgb(78, 201, 176);">_{\text{post-policy}}(x) - </span><span style="color: rgb(86, 156, 214);">\Phi</span><span style="color: rgb(78, 201, 176);">_{\text{pre-policy}}(x)</span><span style="color: rgb(78, 201, 176);">$</span><span style="color: rgb(230, 230, 230);">. Selection:</span></span>
