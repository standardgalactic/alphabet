<span class="line"><span style="color: rgb(86, 156, 214);">\nabla</span><span style="color: rgb(86, 156, 214);"> \cdot</span><span style="color: rgb(78, 201, 176);"> \mathcal{V} = </span><span style="color: rgb(86, 156, 214);">\rho</span><span style="color: rgb(78, 201, 176);">_{\text{sources}} - </span><span style="color: rgb(86, 156, 214);">\rho</span><span style="color: rgb(78, 201, 176);">_{\text{sinks}}</span></span>
