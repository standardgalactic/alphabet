<div class="_tableContainer_16hzy_1"><div tabindex="-1" class="_tableWrapper_16hzy_14 group flex w-fit flex-col-reverse"><table data-start="2306" data-end="3199" class="w-fit min-w-(--thread-content-width)"><thead data-start="2306" data-end="2454"><tr data-start="2306" data-end="2454"><th data-start="2306" data-end="2337" data-col-size="sm">Function</th><th data-start="2337" data-end="2371" data-col-size="sm">Semantic Layer</th><th data-start="2371" data-end="2409" data-col-size="sm">Physical Layer</th><th data-start="2409" data-end="2454" data-col-size="md">Holographic Tartan Layer</th></tr></thead><tbody data-start="2604" data-end="3199"><tr data-start="2604" data-end="2752"><td data-start="2604" data-end="2634" data-col-size="sm"><strong data-start="2606" data-end="2622">Encodes What</strong></td><td data-start="2634" data-end="2669" data-col-size="sm">Ontological Identity</td><td data-start="2669" data-end="2707" data-col-size="sm">Embodied State</td><td data-start="2707" data-end="2752" data-col-size="md">Scene Layout, Contextual Redundancy</td></tr><tr data-start="2753" data-end="2901"><td data-start="2753" data-end="2783" data-col-size="sm"><strong data-start="2755" data-end="2779">Modulation Mechanism</strong></td><td data-start="2783" data-end="2818" data-col-size="sm">Color wheel + blink templates</td><td data-start="2818" data-end="2856" data-col-size="sm">Gaussian aura fields</td><td data-start="2856" data-end="2901" data-col-size="md">Recursive tiling + semantic overlays</td></tr><tr data-start="2902" data-end="3050"><td data-start="2902" data-end="2932" data-col-size="sm"><strong data-start="2904" data-end="2932">Certainty Representation</strong></td><td data-start="2932" data-end="2967" data-col-size="sm">Aura width (ergodicity)</td><td data-start="2967" data-end="3005" data-col-size="sm">Sensor-confirmed dynamics</td><td data-start="3005" data-end="3050" data-col-size="md">Redundant layout &amp; evidence reinforcement</td></tr><tr data-start="3051" data-end="3199"><td data-start="3051" data-end="3081" data-col-size="sm"><strong data-start="3053" data-end="3077">Stylistic Projection</strong></td><td data-start="3081" data-end="3116" data-col-size="sm">Painting/camera modulation</td><td data-start="3116" data-end="3154" data-col-size="sm">Velocity-based stretching</td><td data-start="3154" data-end="3199" data-col-size="md">Time-folded holography</td></tr></tbody></table><div class="sticky end-(--thread-content-margin) h-0 self-end select-none"><div class="absolute end-0 flex items-end" style="height: 48.7031px;"><span class="" data-state="closed"><button class="bg-token-bg-primary hover:bg-token-bg-tertiary text-token-text-secondary my-1 rounded-sm p-1 transition-opacity group-[:not(:hover):not(:focus-within)]:pointer-events-none group-[:not(:hover):not(:focus-within)]:opacity-0"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="icon-md-heavy"><path fill-rule="evenodd" clip-rule="evenodd" d="M7 5C7 3.34315 8.34315 2 10 2H19C20.6569 2 22 3.34315 22 5V14C22 15.6569 20.6569 17 19 17H17V19C17 20.6569 15.6569 22 14 22H5C3.34315 22 2 20.6569 2 19V10C2 8.34315 3.34315 7 5 7H7V5ZM9 7H14C15.6569 7 17 8.34315 17 10V15H19C19.5523 15 20 14.5523 20 14V5C20 4.44772 19.5523 4 19 4H10C9.44772 4 9 4.44772 9 5V7ZM5 9C4.44772 9 4 9.44772 4 10V19C4 19.5523 4.44772 20 5 20H14C14.5523 20 15 19.5523 15 19V10C15 9.44772 14.5523 9 14 9H5Z" fill="currentColor"></path></svg></button></span></div></div></div></div>
<hr data-start="3201" data-end="3204" class="">
<p data-start="3206" data-end="3266" class="">This tri-layer framework gives TARTAN its distinctive power:</p>
<ul data-start="3267" data-end="3431">
