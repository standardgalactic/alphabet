pan><span style="color: rgb(230, 230, 230);">}</span></span>
<span class="line"><span style="color: rgb(197, 134, 192);">\usepackage</span><span style="color: rgb(230, 230, 230);">[</span><span style="color: rgb(156, 220, 254);">margin=1in</span><span style="color: rgb(230, 230, 230);">]{</span><span style="color: rgb(78, 201, 176);">geometry</span><span style="color: rgb(230, 230, 230);">}</span></span>
