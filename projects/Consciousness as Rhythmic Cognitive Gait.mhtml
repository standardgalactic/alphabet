&nbsp;&nbsp;vector[N] S_obs;                 // observed cycle strength (optional)
}
parameters {
&nbsp;&nbsp;vector&lt;lower=0,upper=2<span>*pi()&gt;[K] theta;      // global angles
&nbsp;&nbsp;vector[N] phi;                               // subject phase shifts
&nbsp;&nbsp;real&lt;lower=0&gt; kappa_phi;
&nbsp;&nbsp;real&lt;lower=0&gt; kappa_theta;
