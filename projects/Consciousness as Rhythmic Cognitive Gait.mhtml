&nbsp;&nbsp;real&lt;lower=0&gt; sigma_Ece;
&nbsp;&nbsp;real&lt;lower=0&gt; sigma_S;                       // optional S noise
}
transformed parameters {
&nbsp;&nbsp;// Cholesky for ACE components
&nbsp;&nbsp;matrix[N,N] L_K = cholesky_decompose(KIN + 1e-6*</span>diag_matrix(rep_vector(1.0,N)));
&nbsp;&nbsp;vector[N] a = sigma_Ace * (L_K * a_raw);
&nbsp;&nbsp;vector[N] c = sigma_Cce * (a_raw*0 + c_raw); // use block/GROUP structure in practice
}
model {
&nbsp;&nbsp;// Priors
&nbsp;&nbsp;beta0 ~ normal(0, 0.2);
&nbsp;&nbsp;gamma ~ normal(0, 1); // half-normal via &lt;lower=0&gt;
&nbsp;&nbsp;sigma_A ~ normal(0, 0.5);
&nbsp;&nbsp;kappa_phi ~ normal(0, 2);
&nbsp;&nbsp;kappa_theta ~ normal(0, 2);
&nbsp;&nbsp;alpha_r ~ normal(0, 1);
&nbsp;&nbsp;beta_r ~ normal(0, 1);
&nbsp;&nbsp;a_raw ~ normal(0,1);
&nbsp;&nbsp;c_raw ~ normal(0,1);
&nbsp;&nbsp;sigma_Ace ~ normal(0,1);
&nbsp;&nbsp;sigma_Cce ~ normal(0,1);
&nbsp;&nbsp;sigma_Ece ~ normal(0,1);
&nbsp;&nbsp;if (use_S == 1) sigma_S ~ normal(0,0.5);</p>
<p dir="auto" class="break-words" style="white-space: pre-wrap;">&nbsp;&nbsp;// Soft repulsion on theta (not shown; add target += repulsion(theta);)</p>
<p dir="auto" class="break-words" style="white-space: pre-wrap;">&nbsp;&nbsp;// FO-asymmetry likelihood
&nbsp;&nbsp;for (s in 1:N) {
&nbsp;&nbsp;&nbsp;&nbsp;vector[K] thetas = theta + phi[s]; // implicit wrap to [0,2pi)
&nbsp;&nbsp;&nbsp;&nbsp;for (m in 1:K) for (n in 1:K) if (m != n) {
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;real mu = beta0 + gamma[s] * sin(thetas[m] - thetas[n]);
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;A[s][m,n] ~ normal(mu, sigma_A);
&nbsp;&nbsp;&nbsp;&nbsp;}
&nbsp;&nbsp;}</p>
<p dir="auto" class="break-words" style="white-space: pre-wrap;">&nbsp;&nbsp;// Cycle rate ACE model
&nbsp;&nbsp;for (s in 1:N) {
&nbsp;&nbsp;&nbsp;&nbsp;log_rate[s] ~ normal(alpha_r + X[s] * beta_r + a[s] + c[s], sigma_Ece);
&nbsp;&nbsp;}</p>
<p dir="auto" class="break-words" style="white-space: pre-wrap;">&nbsp;&nbsp;// Optional: direct S model S_obs ~ normal(f_S(theta, gamma), sigma_S);
}
generated quantities {
