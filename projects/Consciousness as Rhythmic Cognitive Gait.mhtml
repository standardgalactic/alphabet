<p dir="auto" class="break-words" style="white-space: pre-wrap;">\part{Falsification Regime}</p>
<p dir="auto" class="break-words" style="white-space: pre-wrap;">\section{Core falsifiable claims}</p>
<p dir="auto" class="break-words" style="white-space: pre-wrap;">\begin{enumerate}
