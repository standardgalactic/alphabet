</span><span><span class="hljs-keyword">\node</span></span><span>[test, below=of start] (drift) {Compute Drift </span><span><span class="hljs-built_in">$</span></span><span><span class="hljs-keyword">\Delta</span></span><span> </span><span><span class="hljs-keyword">\mathcal</span></span><span>{I}</span><span><span class="hljs-built_in">_</span></span><span>t = </span><span><span class="hljs-keyword">\|</span></span><span><span class="hljs-keyword">\mathcal</span></span><span>{I}(C</span><span><span class="hljs-built_in">_</span></span><span>t) - </span><span><span class="hljs-keyword">\mathcal</span></span><span>{I}(C</span><span><span class="hljs-built_in">_</span></span><span>0)</span><span><span class="hljs-keyword">\|</span></span><span><span class="hljs-built_in">$</span></span><span>};

</span><span><span class="hljs-keyword">\node</span></span><span>[decision, below=of drift] (driftQ) {</span><span><span class="hljs-built_in">$</span></span><span><span class="hljs-keyword">\Delta</span></span><span> </span><span><span class="hljs-keyword">\mathcal</span></span><span>{I}</span><span><span class="hljs-built_in">_</span></span><span>t = 0</span><span><span class="hljs-built_in">$</span></span><span>?};

</span><span><span class="hljs-keyword">\node</span></span><span>[test, right=of driftQ, xshift=1.4cm] (leaf) {Leaf Membership </span><span><span class="hljs-keyword">\\</span></span><span> </span><span><span class="hljs-built_in">$</span></span><span>C</span><span><span class="hljs-built_in">_</span></span><span>t </span><span><span class="hljs-keyword">\in</span></span><span> </span><span><span class="hljs-keyword">\mathcal</span></span><span>{X}</span><span><span class="hljs-built_in">_</span></span><span>{</span><span><span class="hljs-keyword">\alpha</span></span><span><span class="hljs-built_in">_</span></span><span>0}</span><span><span class="hljs-built_in">$</span></span><span>};

</span><span><span class="hljs-keyword">\node</span></span><span>[decision, below=of leaf] (leafQ) {Same Leaf?};

</span><span><span class="hljs-keyword">\node</span></span><span>[test, below=of driftQ, yshift=-1.2cm] (spectral) {Spectral Test </span><span><span class="hljs-keyword">\\</span></span><span> </span><span><span class="hljs-built_in">$</span></span><span><span class="hljs-keyword">\operatorname</span></span><span>{Re}(</span><span><span class="hljs-keyword">\lambda</span></span><span>) </span><span><span class="hljs-keyword">\le</span></span><span> 0</span><span><span class="hljs-built_in">$</span></span><span>};

</span><span><span class="hljs-keyword">\node</span></span><span>[decision, below=of spectral] (specQ) {Stable Spectrum?};

</span><span><span class="hljs-keyword">\node</span></span><span>[test, left=of specQ, xshift=-1.4cm] (quot) {Quotient Gap </span><span><span class="hljs-keyword">\\</span></span><span> </span><span><span class="hljs-built_in">$</span></span><span><span class="hljs-keyword">\|</span></span><span><span class="hljs-keyword">\theta</span></span><span><span class="hljs-built_in">_</span></span><span>t</span><span><span class="hljs-built_in">^</span></span><span>{</span><span><span class="hljs-keyword">\text</span></span><span>{SGD}} - </span><span><span class="hljs-keyword">\theta</span></span><span><span class="hljs-built_in">_</span></span><span>t</span><span><span class="hljs-built_in">^</span></span><span>{</span><span><span class="hljs-keyword">\mathcal</span></span><span>{Q}}</span><span><span class="hljs-keyword">\|</span></span><span> </span><span><span class="hljs-keyword">\approx</span></span><span> 0</span><span><span class="hljs-built_in">$</span></span><span>};

</span><span><span class="hljs-keyword">\node</span></span><span>[decision, above=of quot] (quotQ) {Gap </span><span><span class="hljs-built_in">$</span></span><span><span class="hljs-keyword">\approx</span></span><span> 0</span><span><span class="hljs-built_in">$</span></span><span>?};

</span><span><span class="hljs-keyword">\node</span></span><span>[test, below=of specQ, yshift=-1.2cm] (self) {Self-Improvement </span><span><span class="hljs-keyword">\\</span></span><span> </span><span><span class="hljs-built_in">$</span></span><span><span class="hljs-keyword">\mathcal</span></span><span>{I}(C</span><span><span class="hljs-built_in">^</span></span><span>{(k)}) = </span><span><span class="hljs-keyword">\mathcal</span></span><span>{I}(C)</span><span><span class="hljs-built_in">$</span></span><span>};

</span><span><span class="hljs-keyword">\node</span></span><span>[decision, below=of self] (selfQ) {Invariant?};

</span><span><span class="hljs-keyword">\node</span></span><span>[pass, below=of selfQ, yshift=-0.6cm] (accept) {Invariant Alignment</span><span><span class="hljs-keyword">\\</span></span><span>Not Falsified};

</span><span><span class="hljs-keyword">\node</span></span><span>[fail, right=of selfQ, xshift=1.6cm] (reject) {Invariant Alignment</span><span><span class="hljs-keyword">\\</span></span><span>Falsified};

</span><span><span class="hljs-comment">% Connections</span></span><span>
</span><span><span class="hljs-keyword">\draw</span></span><span>[arrow] (start) -- (drift);
</span><span><span class="hljs-keyword">\draw</span></span><span>[arrow] (drift) -- (driftQ);
</span><span><span class="hljs-keyword">\draw</span></span><span>[arrow] (driftQ) -- node[left]{Yes} (spectral);
</span><span><span class="hljs-keyword">\draw</span></span><span>[arrow] (driftQ) -- node[above]{No} (reject);

</span><span><span class="hljs-keyword">\draw</span></span><span>[arrow] (spectral) -- (specQ);
</span><span><span class="hljs-keyword">\draw</span></span><span>[arrow] (specQ) -- node[left]{Yes} (self);
</span><span><span class="hljs-keyword">\draw</span></span><span>[arrow] (specQ) -- node[above right]{No} (reject);

</span><span><span class="hljs-keyword">\draw</span></span><span>[arrow] (self) -- (selfQ);
</span><span><span class="hljs-keyword">\draw</span></span><span>[arrow] (selfQ) -- node[left]{Yes} (accept);
</span><span><span class="hljs-keyword">\draw</span></span><span>[arrow] (selfQ) -- node[above]{No} (reject);

</span><span><span class="hljs-keyword">\draw</span></span><span>[arrow] (driftQ.east) -- ++(0.8,0) |- (leaf);
</span><span><span class="hljs-keyword">\draw</span></span><span>[arrow] (leaf) -- (leafQ);
</span><span><span class="hljs-keyword">\draw</span></span><span>[arrow] (leafQ.south) -- ++(0,-0.4) -| (spectral.north);
</span><span><span class="hljs-keyword">\draw</span></span><span>[arrow] (leafQ) -- node[above]{No} (reject);

</span><span><span class="hljs-keyword">\draw</span></span><span>[arrow] (specQ.west) -- ++(-0.8,0) |- (quot);
</span><span><span class="hljs-keyword">\draw</span></span><span>[arrow] (quot) -- (quotQ);
</span><span><span class="hljs-keyword">\draw</span></span><span>[arrow] (quotQ.north) -- ++(0,0.4) -| (drift.south);
</span><span><span class="hljs-keyword">\draw</span></span><span>[arrow] (quotQ) -- node[below]{No} (reject);

</span><span><span class="hljs-keyword">\end</span></span><span>{tikzpicture}
</span><span><span class="hljs-keyword">\caption</span></span><span>{Falsification Flow for Invariant Alignment: any failed test rejects invariant preservation.}
</span><span><span class="hljs-keyword">\end</span></span><span>{figure}
</span></span></code></div></div></pre>
