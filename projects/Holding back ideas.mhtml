Alignment today often optimizes output resemblance, not objective invariance \cite{christiano2022,bai2022,ng2000,weidinger2022,olah2020}. This is a category error: behavioral regularization cannot constrain the manifold of possible objectives.

\section{The Invariance Principle of Scalable Alignment}
\label{sec:invariance}

\begin{definition}[Cognitive Invariant]
Let $C: \mathcal{X} \to \mathcal{Y}$ be the induced cognition map of a system with internal state $\mathcal{X}$. An \emph{invariant} $\mathcal{I}(C)$ is a minimal description of $C$ unchanged under reparameterization, rescaling, or optimization within admissible dynamics.
\end{definition}

\begin{definition}[Optimization Semigroup]
Let $\{U_t\}_{t \geq 0}$ be a one-parameter family of transformations on $\mathcal{X}$ satisfying $U_{t+s} = U_t \circ U_s$ and $U_0 = \mathrm{id}$. We model capability growth as action by this semigroup.
\end{definition}

\textbf{Core claim:} An aligned system satisfies
\[
\mathcal{I}(C \circ U_t) = \mathcal{I}(C) \quad \forall t \ge 0.
\]

