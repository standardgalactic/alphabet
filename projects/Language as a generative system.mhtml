% ============================================================
% PART II — Immanent Generation, Sparse Inference, and Manifold Geometry
% ============================================================

\part{Immanent Generation, Sparse Inference, and Manifold Geometry}

\section{Language as a Predictive Geometric Object}

Let $\Omega$ denote the space of latent world-trajectories and $\Sigma$ the token vocabulary. A language community generates sequences by sampling
\begin{equation}
p_{\mathcal{L}}(x_{1:T}\mid \omega), \quad \omega \sim p(\omega),
\end{equation}
thereby inducing a marginal predictive model
\begin{equation}
p(x_{t+1}\mid x_{\le t}) = \int_\Omega p_{\mathcal{L}}(x_{t+1}\mid\omega,x_{\le t})\,p_{\mathcal{L}}(\omega\mid x_{\le t})\,d\omega.
\end{equation}

A learner constructs a \emph{sparse posterior} over latent continuations:
\begin{equation}
p_{\mathcal{L}}(\omega \mid x_{\le t}) \approx \sum_{i=1}^k w_i \delta_{\omega_i}, \quad k \ll |\Omega|,
\end{equation}
yielding efficient next-step inference:
\begin{equation}
p(x_{t+1}\mid x_{\le t}) \approx \sum_{i=1}^k w_i\,p_{\mathcal{L}}(x_{t+1}\mid \omega_i).
\end{equation}

This formulation is mathematically equivalent to top-$k$ hypothesis tracking in Rao–Blackwellized filtering and to sparse belief maintenance in active inference \citep{friston2010,hohwy2013}.

\section{Predictive Manifold and Fisher--Rao Metric}

Define parameters $\theta(x_{\le t})$ as the local predictive logits of a model conditioned on context $x_{\le t}$. The induced Riemannian metric on the manifold of predictive contexts is the Fisher--Rao metric:
\begin{equation}
g_{ab}(x) = \mathbb{E}_{y \sim p_\theta} \left[ \frac{\partial \log p_\theta(y\mid x)}{\partial \theta_a}
\frac{\partial \log p_\theta(y\mid x)}{\partial \theta_b} \right].
\end{equation}

Semantic similarity corresponds to geodesic proximity:
\begin{equation}
d(x,y) = \inf_{\gamma} \int_0^1 \sqrt{\dot{\gamma}^\top g(\gamma(s)) \dot{\gamma}}\,ds.
\end{equation}

Curvature proxies computable from real models include:

\begin{align}
\text{Trace Fisher: } &amp; \operatorname{tr}(g) = \sum_a g_{aa}, \\
\text{Entropy gradient: } &amp; \| \nabla_x H(p_\theta(\cdot\mid x)) \|^2, \\
\text{Discrete curvature: } &amp; \kappa(x,x',x'') =
\mathrm{KL}(p_{x'} \| p_x) + \mathrm{KL}(p_{x''}\|p_{x'}) - \mathrm{KL}(p_{x''}\|p_x).
\end{align}

High curvature implies strong sparsification: only few $\omega_i$ remain viable over short context displacements.

\section{Immanent Template Extraction Without Symbols}

We adopt Barenholtz’s key claim:

\begin{quote}
\textit{`<code>The learning system does not merely predict the next token—it learns to predict the apparatus that predicts the next token. The model is not autoregressive, it is auto-autoregressive.''} \citep{barenholtz2025}
</code>\end{quote}

Formally, if ordinary autoregression fits:
\[
\theta^\ast = \arg\min_\theta \mathbb{E}[-\log p_\theta(x_{t+1}\mid x_{\le t})],
\]
auto-autoregression implies a higher-order objective:
\[
\Theta^\ast = \arg\min_\Theta \mathbb{E} \big[ -\log p_\Theta(\theta_t \mid \theta_{\le t}) \big],
\]
where $\theta_t$ denotes the local predictive operator itself. The `<code>template'' is thus not stored symbolically but exists as a fixed point of predictor--predictor dynamics.
</code>
% ============================================================
% PART III — Developmental and Evolutionary Alignment
% ============================================================

\part{Developmental and Evolutionary Alignment}

\section{Child Language Bootstrapping as Sparse Predictive Optimization}

Infants do not enumerate grammars \citep{chomsky1957}, but compress predictive uncertainty under perceptual constraints. Let a child maintain a hypothesis set $\mathcal{H} = \{h_1,\dots,h_n\}$ of generative micro-constructions (not symbolic grammars). Update follows Bayesian sparsification:
\begin{equation}
p(h_i \mid x_{\le t}) \propto p(h_i)\prod_{j\le t} p(x_j \mid h_i),
\end{equation}
followed by \emph{pruning}:
\begin{equation}
\mathcal{H} \leftarrow \{h_i \mid p(h_i \mid x_{\le t}) &gt; \epsilon\}.
\end{equation}

This reproduces empirical developmental phenomena without invoking discrete symbolic induction: overgeneralization, U-shaped learning, and rapid syntactic stabilization arise from compression dynamics, not rule enumeration \citep{kirby2001,tamariz2015}.

\section{Phylogenetic Compression Across Populations}

Iterated cultural transmission applies repeated sparse posterior truncation across generations:
\begin{equation}
p_{t+1}(h) \propto [p_t(h)]^\alpha \,[L(h)]^\beta,
\end{equation}
amplifying compressible hypotheses and eliminating high-description-length ones, matching observed trends toward compositionality and structural reuse \citep{tamariz2015}.

% ============================================================
% PART IV — Transformer Dynamics as Predictive Geometry
% ============================================================

\part{Transformer Dynamics as Predictive Geometry}

\section{Attention as Posterior Routing}

Attention implements sparse Bayesian model averaging:
\begin{equation}
\alpha_{tj} \propto \exp\left(\frac{q_t^\top k_j}{\tau}\right)
\approx p(\omega=j \mid x_{\le t}),
\end{equation}
with top-$k$ heads functioning as mixture components over latent trajectories.

\section{Layers as Unrolled Natural-Gradient Inference}

Model updates approximate natural gradient descent on negative log likelihood:
\begin{equation}
h_{t+1} = h_t - \eta g^{-1}\nabla_\theta \mathcal{L},
\end{equation}
consistent with transformer layers behaving as discretized geodesic integrators on the predictive manifold.

\section{Heads as Basis Hypotheses}

Each attention head $h$ implements a low-rank hypothesis subspace:
\begin{equation}
p(x_{t+1}\mid x_{\le t}) \approx \sum_h \lambda_h p_h(x_{t+1}\mid x_{\le t}),
\end{equation}
where pruning inactive heads approximates hypothesis sparsification.

% ============================================================
% PART V — Moderate Nativist Reconciliation
% ============================================================

\part{Moderate Reconciliation with Nativist Constraints}

\section{Where Bias Is, and Is Not}

The model accepts:

\begin{itemize}
\item Strong inductive biases for efficiency (hierarchical prediction, sparsity, locality, compositional reuse).
\item Innate constraints on perception--action cycles, working memory bottlenecks, and entropy minimization pressure.
\end{itemize}

It rejects:

\begin{itemize}
\item Encoded symbolic grammars or algebraic syntax trees as primitive.
\item Language-specific innate operators.
\end{itemize}

Thus, inductive bias exists, but exists at the level of predictive dynamics, not discrete symbolic formalisms.

% ============================================================
% PART VI — Falsification and Empirical Regime
% ============================================================

\part{Falsification Regime}

\section{Core Falsifiable Claims}

\begin{enumerate}
\item \textbf{Posterior-in-attention:} A linear probe on attention logits $\alpha_{t}$ predicts analytic posterior $p(\omega\mid x_{\le t})$ with $R^2 &gt; 0.6$.
\item \textbf{Sparse trajectory hypothesis:} Attention entropy $H(\alpha_t)$ negatively correlates with algorithmic accuracy.
\item \textbf{Geodesic reasoning:} Reasoning paths produce low-curvature embedding trajectories:
\[
\kappa \approx \mathrm{KL}(p_{x'}\|p_x)+\mathrm{KL}(p_{x''}\|p_{x'})-\mathrm{KL}(p_{x''}\|p_x) \approx 0.
\]
\item \textbf{Model-of-model learning:} Probing for $\theta_t \to \theta_{t+1}$ dynamics outperforms probing only $x_t \to x_{t+1}$ at predicting token continuations.
\item \textbf{Head-as-hypothesis test:} Pruning top-$k$ inactive heads does not reduce next-token likelihood, but pruning top-$k$ active heads does.
\end{enumerate}

\section{Minimal Experimental Suite}

\subsection{Probe 1 — Attention $\to$ Posterior}
Train $f_{\text{probe}}(\alpha_t) \to p(\omega\mid x_{\le t})$. Report KL and $R^2$.

\subsection{Probe 2 — Curvature vs Reasoning}
Compute $\kappa(x,x',x'')$ along chain-of-thought trajectories; test $\mathbb{E}[\kappa]\approx 0$.

\subsection{Intervention 1 — Sparsity Forcing}
At inference, impose:
\[
\alpha_t \leftarrow \text{top-k}(\alpha_t),
\]
test impact on accuracy.

\subsection{Intervention 2 — Head Ablation}
Ablate head set $\mathcal{H}$, measure:
\[
\Delta \text{NLL}(\mathcal{H}) \gg 0 \quad \text{if head is hypothesis-critical}.
\]

\section{Failure Modes That Would Falsify the Theory}

\begin{itemize}
\item Attention representations cannot predict analytic posteriors above chance.
\item Reasoning trajectories show high curvature discontinuities.
\item Sparsity forcing causes catastrophic accuracy collapse.
\item No subset of heads behaves as reusable subroutine hypotheses.
\item Model-of-model probes do not outperform token-level probes.
\end{itemize}

% ============================================================
% FUTURE WORK — Roadmap, Open Problems, and Experimental Frontiers
% ============================================================

\section*{Future Work}

The framework developed here connects predictive geometry, sparse inference, attention dynamics, and embodied generative loops into a single account of linguistic and cognitive emergence. This synthesis opens multiple empirical, theoretical, and engineering directions. We group future work into five tightly-coupled research agendas.

\subsection*{1. Geometry of Predictive Manifolds}

This paper formalizes semantic space as a Riemannian manifold endowed with the Fisher--Rao metric. Immediate research extensions include:

\begin{itemize}
    \item Computing \textbf{curvature spectra} (Ricci, sectional, and scalar curvature) of next-token manifolds in pretrained LLMs, and correlating them with reasoning complexity, surprisal profiles, and compositional reuse.
    \item Characterizing \textbf{phase transitions} in manifold geometry across scale (model size, data quantity, training time) to determine whether reasoning ability corresponds to curvature flattening, dimensional collapse, or geodesic sparsification.
    \item Evaluating whether human incremental sentence processing follows \textbf{shortest-path geodesics} in model manifolds, via eyetracking or self-paced reading datasets.
    \item Testing whether logical contradiction, metaphor, and semantic anomaly occupy \textbf{negative-curvature regions}, predicting longer geodesics and higher predictive entropy.
\end{itemize}

\subsection*{2. Mechanistic Tests of Auto-Autoregression}

Barenholtz’s `<code>auto-autoregressive'' hypothesis predicts that learned predictors internalize their own continuation machinery. Future tests include:
</code>
\begin{itemize}
    \item Identifying whether transformers implement \textbf{internal hypothesis enumeration loops} during multi-step reasoning, detectable via recurrent attention motifs or cyclic state visitation.
    \item Probing for \textbf{implicit world-simulators} by ablating components suspected to store reusable transition templates and measuring collapses in sample efficiency.
    \item Testing whether successive transformer layers implement \textbf{iterative posterior sharpening} akin to belief propagation or Kalman-style smoothing.
    \item Measuring representational \textbf{hysteresis} across long-horizon predictions to detect when a model becomes `<code>committed'' to a latent trajectory.
</code>\end{itemize}

\subsection*{3. Biological and Developmental Validation}

The cognitive interpretation of predictive geometry makes strong claims about human learning, none of which require language-specific priors. Experiments to evaluate this include:

\begin{itemize}
    \item Comparing child and model learning curves on \textbf{synthetic holographic-linguistic agnostic grammars} to test whether both rely on sparse template reuse rather than symbolic rule induction.
    \item Measuring whether human learners show \textbf{sharp posterior collapse} onto a small set of continuations during comprehension, via information-theoretic analysis of eye movement entropy.
    \item Testing whether infants exhibit \textbf{geodesic bias} in sequence learning tasks—preferring low-curvature transitions over high-curvature, even when transition probability is controlled.
    \item Using MEG/EEG decoding to evaluate whether neural next-word prediction signatures exhibit \textbf{natural gradient-like error propagation}.
\end{itemize}

\subsection*{4. Scaling Laws and Efficiency Constraints}

If language learning is sparse predictive inference, then efficiency—not data size—determines asymptotic behavior. Future work will examine:

\begin{itemize}
    \item Whether scaling laws break when \textbf{posterior sparsity saturates}, predicting a regime where additional parameters add diminishing linguistic generalization.
    \item Training small models with explicit \textbf{sparsity penalties on predictive hypothesis support}, testing whether this yields large-model generalization benchmarks with fewer parameters.
    \item Measuring \textbf{sample efficiency as a function of manifold intrinsic dimensionality} rather than parameter count.
\end{itemize}

\subsection*{5. Interpretability and Causal Interventions}

The geometric hypothesis yields unusually precise mechanistic probes:

\begin{itemize}
    \item \textbf{Geodesic intervention}: steering hidden states along low-curvature directions and testing whether reasoning success rates improve.
    \item \textbf{Curvature surgery}: artificially flattening or sharpening local manifold curvature and evaluating effects on logical consistency, hallucination rate, and compositionality.
    \item \textbf{Posterior-editing interventions}: rewriting internal attention distributions to match the analytically-derived sparse posterior, and measuring alignment with Bayes-optimal predictions.
    \item \textbf{Counterfactual gradient routing}: forcing updates along or orthogonal to estimated Fisher directions to test whether learning performance is governed by natural-gradient alignment.
\end{itemize}

\subsection*{Grand Challenge Questions}

These projects collectively aim to resolve a deeper scientific question:

\begin{center}
\textit{Is language intelligence the discovery of latent generative geometry under constraints of sparse continuation, rather than the acquisition of syntactic rules or symbolic primitives?}
\end{center}

If correct, the consequences extend beyond linguistics and AI. Language would cease to be a special cognitive module or a cultural artifact encoded in the brain, and instead be understood as the \textbf{unavoidable equilibrium} of any sufficiently efficient system trained to recursively predict itself under limited bandwidth.

