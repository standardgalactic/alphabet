  </span><span><span class="hljs-keyword">let</span></span><span> ok = </span><span><span class="hljs-keyword">await</span></span><span> </span><span><span class="hljs-title function_">fetchAndParse</span></span><span>(</span><span><span class="hljs-string">"background/Geometric_Consciousness_and_LLMs.vtt"</span></span><span>, </span><span><span class="hljs-string">"vtt"</span></span><span>);
  </span><span><span class="hljs-keyword">if</span></span><span> (!ok) {
    subtitleDiv.</span><span><span class="hljs-property">textContent</span></span><span> = </span><span><span class="hljs-string">"[Loading SRT…]"</span></span><span>;
    ok = </span><span><span class="hljs-keyword">await</span></span><span> </span><span><span class="hljs-title function_">fetchAndParse</span></span><span>(</span><span><span class="hljs-string">"background/Geometric_Consciousness_and_LLMs.srt"</span></span><span>, </span><span><span class="hljs-string">"srt"</span></span><span>);
