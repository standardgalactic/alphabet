  </span><span><span class="hljs-keyword">if</span></span><span> (sub) {
    </span><span><span class="hljs-keyword">if</span></span><span> (currentIndex !== sub.</span><span><span class="hljs-property">start</span></span><span>) {
      subtitleDiv.</span><span><span class="hljs-property">textContent</span></span><span> = sub.</span><span><span class="hljs-property">text</span></span><span>;
      currentIndex = sub.</span><span><span class="hljs-property">start</span></span><span>;
    }
  } </span><span><span class="hljs-keyword">else</span></span><span> {
    subtitleDiv.</span><span><span class="hljs-property">textContent</span></span><span> = </span><span><span class="hljs-string">""</span></span><span>;
    currentIndex = -</span><span><span class="hljs-number">1</span></span><span>;
