})();

</span><span><span class="hljs-keyword">async</span></span><span> </span><span><span class="hljs-keyword">function</span></span><span> </span><span><span class="hljs-title function_">fetchAndParse</span></span><span>(</span><span><span class="hljs-params">path, type</span></span><span>) {
  </span><span><span class="hljs-keyword">try</span></span><span> {
    </span><span><span class="hljs-keyword">const</span></span><span> res = </span><span><span class="hljs-keyword">await</span></span><span> </span><span><span class="hljs-title function_">fetch</span></span><span>(path);
    </span><span><span class="hljs-keyword">if</span></span><span> (!res.</span><span><span class="hljs-property">ok</span></span><span>) </span><span><span class="hljs-keyword">return</span></span><span> </span><span><span class="hljs-literal">false</span></span><span>;
    </span><span><span class="hljs-keyword">const</span></span><span> text = </span><span><span class="hljs-keyword">await</span></span><span> res.</span><span><span class="hljs-title function_">text</span></span><span>();
    </span><span><span class="hljs-title function_">parseSubs</span></span><span>(text, type);
    </span><span><span class="hljs-keyword">return</span></span><span> subtitles.</span><span><span class="hljs-property">length</span></span><span> &gt; </span><span><span class="hljs-number">0</span></span><span>;
  } </span><span><span class="hljs-keyword">catch</span></span><span> (e) {
    </span><span><span class="hljs-variable language_">console</span></span><span>.</span><span><span class="hljs-title function_">warn</span></span><span>(</span><span><span class="hljs-string">"Subtitle load failed:"</span></span><span>, e);
    </span><span><span class="hljs-keyword">return</span></span><span> </span><span><span class="hljs-literal">false</span></span><span>;
  }
}

</span><span><span class="hljs-keyword">function</span></span><span> </span><span><span class="hljs-title function_">parseSubs</span></span><span>(</span><span><span class="hljs-params">data, type</span></span><span>) {
  subtitles = [];
  </span><span><span class="hljs-keyword">if</span></span><span> (type === </span><span><span class="hljs-string">"vtt"</span></span><span> &amp;&amp; data.</span><span><span class="hljs-title function_">startsWith</span></span><span>(</span><span><span class="hljs-string">"WEBVTT"</span></span><span>)) {
    </span><span><span class="hljs-comment">// WebVTT format</span></span><span>
    </span><span><span class="hljs-keyword">const</span></span><span> blocks = data.</span><span><span class="hljs-title function_">split</span></span><span>(</span><span><span class="hljs-regexp">/\n\n+/</span></span><span>);
    </span><span><span class="hljs-keyword">for</span></span><span> (</span><span><span class="hljs-keyword">const</span></span><span> b </span><span><span class="hljs-keyword">of</span></span><span> blocks) {
      </span><span><span class="hljs-keyword">const</span></span><span> match = b.</span><span><span class="hljs-title function_">match</span></span><span>(</span><span><span class="hljs-regexp">/(\d{2}:\d{2}:\d{2}\.\d{3}) --&gt; (\d{2}:\d{2}:\d{2}\.\d{3})/</span></span><span>);
      </span><span><span class="hljs-keyword">if</span></span><span> (!match) </span><span><span class="hljs-keyword">continue</span></span><span>;
      </span><span><span class="hljs-keyword">const</span></span><span> [_, start, end] = match;
      </span><span><span class="hljs-keyword">const</span></span><span> text = b.</span><span><span class="hljs-title function_">split</span></span><span>(</span><span><span class="hljs-string">"\n"</span></span><span>).</span><span><span class="hljs-title function_">slice</span></span><span>(</span><span><span class="hljs-number">1</span></span><span>).</span><span><span class="hljs-title function_">join</span></span><span>(</span><span><span class="hljs-string">" "</span></span><span>).</span><span><span class="hljs-title function_">trim</span></span><span>();
      subtitles.</span><span><span class="hljs-title function_">push</span></span><span>({ </span><span><span class="hljs-attr">start</span></span><span>: </span><span><span class="hljs-title function_">toSec</span></span><span>(start), </span><span><span class="hljs-attr">end</span></span><span>: </span><span><span class="hljs-title function_">toSec</span></span><span>(end), text });
    }
  } </span><span><span class="hljs-keyword">else</span></span><span> </span><span><span class="hljs-keyword">if</span></span><span> (type === </span><span><span class="hljs-string">"srt"</span></span><span>) {
    </span><span><span class="hljs-comment">// SRT format</span></span><span>
    </span><span><span class="hljs-keyword">const</span></span><span> blocks = data.</span><span><span class="hljs-title function_">trim</span></span><span>().</span><span><span class="hljs-title function_">split</span></span><span>(</span><span><span class="hljs-regexp">/\n\n+/</span></span><span>);
    </span><span><span class="hljs-keyword">for</span></span><span> (</span><span><span class="hljs-keyword">const</span></span><span> b </span><span><span class="hljs-keyword">of</span></span><span> blocks) {
      </span><span><span class="hljs-keyword">const</span></span><span> lines = b.</span><span><span class="hljs-title function_">split</span></span><span>(</span><span><span class="hljs-string">"\n"</span></span><span>);
      </span><span><span class="hljs-keyword">if</span></span><span> (lines.</span><span><span class="hljs-property">length</span></span><span> &lt; </span><span><span class="hljs-number">2</span></span><span>) </span><span><span class="hljs-keyword">continue</span></span><span>;
      </span><span><span class="hljs-keyword">const</span></span><span> times = lines[</span><span><span class="hljs-number">1</span></span><span>].</span><span><span class="hljs-title function_">match</span></span><span>(</span><span><span class="hljs-regexp">/(\d{2}:\d{2}:\d{2}),(\d{3}) --&gt; (\d{2}:\d{2}:\d{2}),(\d{3})/</span></span><span>);
      </span><span><span class="hljs-keyword">if</span></span><span> (!times) </span><span><span class="hljs-keyword">continue</span></span><span>;
      </span><span><span class="hljs-keyword">const</span></span><span> start = </span><span><span class="hljs-string">`<span class="hljs-subst">${times[<span class="hljs-number">1</span></span></span></span><span>]}.</span><span><span class="hljs-subst">${times[<span class="hljs-number">2</span></span></span><span>]}`;
      </span><span><span class="hljs-keyword">const</span></span><span> end = </span><span><span class="hljs-string">`<span class="hljs-subst">${times[<span class="hljs-number">3</span></span></span></span><span>]}.</span><span><span class="hljs-subst">${times[<span class="hljs-number">4</span></span></span><span>]}`;
      </span><span><span class="hljs-keyword">const</span></span><span> text = lines.</span><span><span class="hljs-title function_">slice</span></span><span>(</span><span><span class="hljs-number">2</span></span><span>).</span><span><span class="hljs-title function_">join</span></span><span>(</span><span><span class="hljs-string">" "</span></span><span>).</span><span><span class="hljs-title function_">trim</span></span><span>();
      subtitles.</span><span><span class="hljs-title function_">push</span></span><span>({ </span><span><span class="hljs-attr">start</span></span><span>: </span><span><span class="hljs-title function_">toSec</span></span><span>(start), </span><span><span class="hljs-attr">end</span></span><span>: </span><span><span class="hljs-title function_">toSec</span></span><span>(end), text });
    }
  }
}

</span><span><span class="hljs-keyword">function</span></span><span> </span><span><span class="hljs-title function_">toSec</span></span><span>(</span><span><span class="hljs-params">t</span></span><span>) {
  </span><span><span class="hljs-keyword">const</span></span><span> [h, m, s] = t.</span><span><span class="hljs-title function_">split</span></span><span>(</span><span><span class="hljs-string">":"</span></span><span>);
  </span><span><span class="hljs-keyword">return</span></span><span> </span><span><span class="hljs-built_in">parseFloat</span></span><span>(h) * </span><span><span class="hljs-number">3600</span></span><span> + </span><span><span class="hljs-built_in">parseFloat</span></span><span>(m) * </span><span><span class="hljs-number">60</span></span><span> + </span><span><span class="hljs-built_in">parseFloat</span></span><span>(s);
}

player.</span><span><span class="hljs-title function_">addEventListener</span></span><span>(</span><span><span class="hljs-string">"timeupdate"</span></span><span>, </span><span><span class="hljs-function">() =&gt;</span></span><span> {
  </span><span><span class="hljs-keyword">if</span></span><span> (subtitles.</span><span><span class="hljs-property">length</span></span><span> === </span><span><span class="hljs-number">0</span></span><span>) </span><span><span class="hljs-keyword">return</span></span><span>;
