1057 5.53708 6.00551 6.00391 6.00391C6.00551 5.53708 6.01057 5.14051 6.03809 4.80371C6.0755 4.34588 6.15483 3.94012 6.34668 3.56348L6.46875 3.34473C6.77282 2.84912 7.20856 2.44514 7.72949 2.17969L7.87207 2.11328C8.20855 1.96886 8.56979 1.90385 8.9707 1.87109C9.42091 1.83432 9.978 1.83496 10.667 1.83496H13.5C14.1891 1.83496 14.746 1.83431 15.1963 1.87109C15.6541 1.90851 16.0599 1.98788 16.4365 2.17969L16.6553 2.30176C17.151 2.60585 17.5548 3.04244 17.8203 3.56348L17.8867 3.70606C18.031 4.04235 18.0962 4.40306 18.1289 4.80371C18.1657 5.25395 18.165 5.81091 18.165 6.5V9.33301Z"></path></svg>Copy code</button></div></div></div><div class="overflow-y-auto p-4" dir="ltr"><code class="whitespace-pre! language-html"><span><span><span class="hljs-tag">&lt;<span class="hljs-name">script</span></span></span><span>&gt;<span class="language-javascript">
</span></span><span><span class="hljs-comment">// -------- Subtitles Sync with Audio (improved) --------</span></span><span>
</span><span><span class="hljs-keyword">const</span></span><span> player = </span><span><span class="hljs-variable language_">document</span></span><span>.</span><span><span class="hljs-title function_">getElementById</span></span><span>(</span><span><span class="hljs-string">'player'</span></span><span>);
</span><span><span class="hljs-keyword">const</span></span><span> subtitleDiv = </span><span><span class="hljs-variable language_">document</span></span><span>.</span><span><span class="hljs-title function_">getElementById</span></span><span>(</span><span><span class="hljs-string">'subtitle'</span></span><span>);

</span><span><span class="hljs-keyword">let</span></span><span> subtitles = [];
</span><span><span class="hljs-keyword">let</span></span><span> currentSub = -</span><span><span class="hljs-number">1</span></span><span>;

</span><span><span class="hljs-comment">// try VTT first, then SRT</span></span><span>
</span><span><span class="hljs-title function_">loadSubtitles</span></span><span>(</span><span><span class="hljs-string">'background/Geometric_Consciousness_and_LLMs.vtt'</span></span><span>)
  .</span><span><span class="hljs-title function_">catch</span></span><span>(</span><span><span class="hljs-function">() =&gt;</span></span><span> </span><span><span class="hljs-title function_">loadSubtitles</span></span><span>(</span><span><span class="hljs-string">'background/Geometric_Consciousness_and_LLMs.srt'</span></span><span>))
  .</span><span><span class="hljs-title function_">then</span></span><span>(</span><span><span class="hljs-function"><span class="hljs-params">ok</span></span></span><span> =&gt; {
    </span><span><span class="hljs-keyword">if</span></span><span> (ok) subtitleDiv.</span><span><span class="hljs-property">textContent</span></span><span> = </span><span><span class="hljs-string">"[Subtitles loaded — press play]"</span></span><span>;
    </span><span><span class="hljs-keyword">else</span></span><span> subtitleDiv.</span><span><span class="hljs-property">textContent</span></span><span> = </span><span><span class="hljs-string">"[No subtitles found]"</span></span><span>;
  });

</span><span><span class="hljs-keyword">async</span></span><span> </span><span><span class="hljs-keyword">function</span></span><span> </span><span><span class="hljs-title function_">loadSubtitles</span></span><span>(</span><span><span class="hljs-params">path</span></span><span>) {
  </span><span><span class="hljs-keyword">try</span></span><span> {
    </span><span><span class="hljs-keyword">const</span></span><span> res = </span><span><span class="hljs-keyword">await</span></span><span> </span><span><span class="hljs-title function_">fetch</span></span><span>(path);
    </span><span><span class="hljs-keyword">if</span></span><span> (!res.</span><span><span class="hljs-property">ok</span></span><span>) </span><span><span class="hljs-keyword">return</span></span><span> </span><span><span class="hljs-literal">false</span></span><span>;
    </span><span><span class="hljs-keyword">const</span></span><span> text = </span><span><span class="hljs-keyword">await</span></span><span> res.</span><span><span class="hljs-title function_">text</span></span><span>();
    </span><span><span class="hljs-title function_">parseSubtitles</span></span><span>(text);
    </span><span><span class="hljs-keyword">return</span></span><span> </span><span><span class="hljs-literal">true</span></span><span>;
  } </span><span><span class="hljs-keyword">catch</span></span><span> {
    </span><span><span class="hljs-keyword">return</span></span><span> </span><span><span class="hljs-literal">false</span></span><span>;
  }
}

</span><span><span class="hljs-keyword">function</span></span><span> </span><span><span class="hljs-title function_">parseSubtitles</span></span><span>(</span><span><span class="hljs-params">data</span></span><span>) {
  </span><span><span class="hljs-comment">// detect format</span></span><span>
  </span><span><span class="hljs-keyword">if</span></span><span> (data.</span><span><span class="hljs-title function_">startsWith</span></span><span>(</span><span><span class="hljs-string">"WEBVTT"</span></span><span>)) {
    </span><span><span class="hljs-comment">// WebVTT</span></span><span>
    </span><span><span class="hljs-keyword">const</span></span><span> pattern = </span><span><span class="hljs-regexp">/(\d{2}:\d{2}:\d{2}\.\d{3}) --&gt; (\d{2}:\d{2}:\d{2}\.\d{3})[\s\S]*?(?=\n\n|$)/g</span></span><span>;
    </span><span><span class="hljs-keyword">let</span></span><span> match;
    </span><span><span class="hljs-keyword">while</span></span><span> ((match = pattern.</span><span><span class="hljs-title function_">exec</span></span><span>(data)) !== </span><span><span class="hljs-literal">null</span></span><span>) {
      </span><span><span class="hljs-keyword">const</span></span><span> lines = match[</span><span><span class="hljs-number">0</span></span><span>].</span><span><span class="hljs-title function_">split</span></span><span>(</span><span><span class="hljs-string">'\n'</span></span><span>).</span><span><span class="hljs-title function_">slice</span></span><span>(</span><span><span class="hljs-number">1</span></span><span>).</span><span><span class="hljs-title function_">join</span></span><span>(</span><span><span class="hljs-string">' '</span></span><span>);
      </span><span><span class="hljs-keyword">const</span></span><span> [start, end] = match[</span><span><span class="hljs-number">1</span></span><span>] ? [match[</span><span><span class="hljs-number">1</span></span><span>], match[</span><span><span class="hljs-number">2</span></span><span>]] : [];
      subtitles.</span><span><span class="hljs-title function_">push</span></span><span>({
        </span><span><span class="hljs-attr">start</span></span><span>: </span><span><span class="hljs-title function_">toSecondsVTT</span></span><span>(match[</span><span><span class="hljs-number">1</span></span><span>]),
        </span><span><span class="hljs-attr">end</span></span><span>: </span><span><span class="hljs-title function_">toSecondsVTT</span></span><span>(match[</span><span><span class="hljs-number">2</span></span><span>]),
        </span><span><span class="hljs-attr">text</span></span><span>: lines.</span><span><span class="hljs-title function_">trim</span></span><span>()
      });
    }
  } </span><span><span class="hljs-keyword">else</span></span><span> {
    </span><span><span class="hljs-comment">// SRT</span></span><span>
    </span><span><span class="hljs-keyword">const</span></span><span> pattern = </span><span><span class="hljs-regexp">/\d+\s*\n(\d{2}:\d{2}:\d{2}),(\d{3}) --&gt; (\d{2}:\d{2}:\d{2}),(\d{3})\s*\n([\s\S]*?)(?=\n\n|$)/g</span></span><span>;
    </span><span><span class="hljs-keyword">let</span></span><span> match;
    </span><span><span class="hljs-keyword">while</span></span><span> ((match = pattern.</span><span><span class="hljs-title function_">exec</span></span><span>(data)) !== </span><span><span class="hljs-literal">null</span></span><span>) {
      </span><span><span class="hljs-keyword">const</span></span><span> start = </span><span><span class="hljs-string">`<span class="hljs-subst">${match[<span class="hljs-number">1</span></span></span></span><span>]}.</span><span><span class="hljs-subst">${match[<span class="hljs-number">2</span></span></span><span>]}`;
      </span><span><span class="hljs-keyword">const</span></span><span> end = </span><span><span class="hljs-string">`<span class="hljs-subst">${match[<span class="hljs-number">3</span></span></span></span><span>]}.</span><span><span class="hljs-subst">${match[<span class="hljs-number">4</span></span></span><span>]}`;
      subtitles.</span><span><span class="hljs-title function_">push</span></span><span>({
        </span><span><span class="hljs-attr">start</span></span><span>: </span><span><span class="hljs-title function_">toSecondsVTT</span></span><span>(start),
        </span><span><span class="hljs-attr">end</span></span><span>: </span><span><span class="hljs-title function_">toSecondsVTT</span></span><span>(end),
        </span><span><span class="hljs-attr">text</span></span><span>: match[</span><span><span class="hljs-number">5</span></span><span>].</span><span><span class="hljs-title function_">replace</span></span><span>(</span><span><span class="hljs-regexp">/\n/g</span></span><span>, </span><span><span class="hljs-string">' '</span></span><span>).</span><span><span class="hljs-title function_">trim</span></span><span>()
      });
    }
  }
}

</span><span><span class="hljs-keyword">function</span></span><span> </span><span><span class="hljs-title function_">toSecondsVTT</span></span><span>(</span><span><span class="hljs-params">t</span></span><span>) {
  </span><span><span class="hljs-keyword">const</span></span><span> [h, m, s] = t.</span><span><span class="hljs-title function_">split</span></span><span>(</span><span><span class="hljs-string">':'</span></span><span>);
  </span><span><span class="hljs-keyword">return</span></span><span> </span><span><span class="hljs-built_in">parseFloat</span></span><span>(h) * </span><span><span class="hljs-number">3600</span></span><span> + </span><span><span class="hljs-built_in">parseFloat</span></span><span>(m) * </span><span><span class="hljs-number">60</span></span><span> + </span><span><span class="hljs-built_in">parseFloat</span></span><span>(s);
}

player.</span><span><span class="hljs-title function_">addEventListener</span></span><span>(</span><span><span class="hljs-string">'timeupdate'</span></span><span>, </span><span><span class="hljs-function">() =&gt;</span></span><span> {
  </span><span><span class="hljs-keyword">const</span></span><span> t = player.</span><span><span class="hljs-property">currentTime</span></span><span>;
  </span><span><span class="hljs-keyword">if</span></span><span> (subtitles.</span><span><span class="hljs-property">length</span></span><span> === </span><span><span class="hljs-number">0</span></span><span>) </span><span><span class="hljs-keyword">return</span></span><span>;

  </span><span><span class="hljs-comment">// keep currentSub if still in range</span></span><span>
  </span><span><span class="hljs-keyword">if</span></span><span> (currentSub &gt;= </span><span><span class="hljs-number">0</span></span><span> &amp;&amp; t &gt;= subtitles[currentSub].</span><span><span class="hljs-property">start</span></span><span> &amp;&amp; t &lt;= subtitles[currentSub].</span><span><span class="hljs-property">end</span></span><span>) </span><span><span class="hljs-keyword">return</span></span><span>;

  </span><span><span class="hljs-comment">// binary search to find current subtitle</span></span><span>
  </span><span><span class="hljs-keyword">let</span></span><span> lo = </span><span><span class="hljs-number">0</span></span><span>, hi = subtitles.</span><span><span class="hljs-property">length</span></span><span> - </span><span><span class="hljs-number">1</span></span><span>;
  </span><span><span class="hljs-keyword">while</span></span><span> (lo &lt;= hi) {
    </span><span><span class="hljs-keyword">const</span></span><span> mid = (lo + hi) &gt;&gt; </span><span><span class="hljs-number">1</span></span><span>;
    </span><span><span class="hljs-keyword">if</span></span><span> (t &lt; subtitles[mid].</span><span><span class="hljs-property">start</span></span><span>) hi = mid - </span><span><span class="hljs-number">1</span></span><span>;
    </span><span><span class="hljs-keyword">else</span></span><span> </span><span><span class="hljs-keyword">if</span></span><span> (t &gt; subtitles[mid].</span><span><span class="hljs-property">end</span></span><span>) lo = mid + </span><span><span class="hljs-number">1</span></span><span>;
    </span><span><span class="hljs-keyword">else</span></span><span> {
      currentSub = mid;
      subtitleDiv.</span><span><span class="hljs-property">textContent</span></span><span> = subtitles[mid].</span><span><span class="hljs-property">text</span></span><span>;
      </span><span><span class="hljs-keyword">return</span></span><span>;
    }
  }
  currentSub = -</span><span><span class="hljs-number">1</span></span><span>;
  subtitleDiv.</span><span><span class="hljs-property">textContent</span></span><span> = </span><span><span class="hljs-string">''</span></span><span>;
});
</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">script</span></span></span><span>&gt;
</span></span></code></div></div></pre>
