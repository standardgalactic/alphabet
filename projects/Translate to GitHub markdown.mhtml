  </span><span><span class="hljs-keyword">while</span></span><span> ((match = pattern.</span><span><span class="hljs-title function_">exec</span></span><span>(data)) !== </span><span><span class="hljs-literal">null</span></span><span>) {
    subtitles.</span><span><span class="hljs-title function_">push</span></span><span>({
      </span><span><span class="hljs-attr">start</span></span><span>: </span><span><span class="hljs-title function_">toSeconds</span></span><span>(match[</span><span><span class="hljs-number">1</span></span><span>]),
      </span><span><span class="hljs-attr">end</span></span><span>: </span><span><span class="hljs-title function_">toSeconds</span></span><span>(match[</span><span><span class="hljs-number">2</span></span><span>]),
      </span><span><span class="hljs-attr">text</span></span><span>: match[</span><span><span class="hljs-number">3</span></span><span>].</span><span><span class="hljs-title function_">replace</span></span><span>(</span><span><span class="hljs-regexp">/\n/g</span></span><span>, </span><span><span class="hljs-string">' '</span></span><span>)
    });
  }
}

</span><span><span class="hljs-keyword">function</span></span><span> </span><span><span class="hljs-title function_">toSeconds</span></span><span>(</span><span><span class="hljs-params">t</span></span><span>) {
  </span><span><span class="hljs-keyword">const</span></span><span> [h,m,s] = t.</span><span><span class="hljs-title function_">split</span></span><span>(</span><span><span class="hljs-string">':'</span></span><span>);
  </span><span><span class="hljs-keyword">return</span></span><span> </span><span><span class="hljs-built_in">parseFloat</span></span><span>(h)*</span><span><span class="hljs-number">3600</span></span><span> + </span><span><span class="hljs-built_in">parseFloat</span></span><span>(m)*</span><span><span class="hljs-number">60</span></span><span> + </span><span><span class="hljs-built_in">parseFloat</span></span><span>(s);
}

player.</span><span><span class="hljs-title function_">addEventListener</span></span><span>(</span><span><span class="hljs-string">'timeupdate'</span></span><span>, </span><span><span class="hljs-function">() =&gt;</span></span><span> {
  </span><span><span class="hljs-keyword">const</span></span><span> t = player.</span><span><span class="hljs-property">currentTime</span></span><span>;
  </span><span><span class="hljs-keyword">for</span></span><span> (</span><span><span class="hljs-keyword">const</span></span><span> sub </span><span><span class="hljs-keyword">of</span></span><span> subtitles) {
    </span><span><span class="hljs-keyword">if</span></span><span> (t &gt;= sub.</span><span><span class="hljs-property">start</span></span><span> &amp;&amp; t &lt;= sub.</span><span><span class="hljs-property">end</span></span><span>) {
      subtitleDiv.</span><span><span class="hljs-property">textContent</span></span><span> = sub.</span><span><span class="hljs-property">text</span></span><span>;
      </span><span><span class="hljs-keyword">return</span></span><span>;
    }
  }
  subtitleDiv.</span><span><span class="hljs-property">textContent</span></span><span> = </span><span><span class="hljs-string">''</span></span><span>;
});
