</span></div><div style="position: absolute; top: 0px; left: 0px; width: 100%; height: 1.5em; transform: translateY(2224.8px);"><span><span></span><span style="color: rgb(198, 120, 221);">\begin</span><span>{itemize}
</span></span></div><div style="position: absolute; top: 0px; left: 0px; width: 100%; height: 1.5em; transform: translateY(2246.4px);"><span><span>    </span><span style="color: rgb(198, 120, 221);">\item</span><span> Scalar capacity </span><span style="color: rgb(198, 120, 221);">\(</span><span style="color: rgb(198, 120, 221);">\phi</span><span>(x,</span><span style="color: rgb(198, 120, 221);">\eta</span><span>)</span><span style="color: rgb(198, 120, 221);">\)</span><span> (drives falling outward),
</span></span></div><div style="position: absolute; top: 0px; left: 0px; width: 100%; height: 1.5em; transform: translateY(2268px);"><span><span>    </span><span style="color: rgb(198, 120, 221);">\item</span><span> Matter density </span><span style="color: rgb(198, 120, 221);">\(</span><span style="color: rgb(198, 120, 221);">\rho</span><span style="color: rgb(230, 192, 123);">_</span><span>m(x,</span><span style="color: rgb(198, 120, 221);">\eta</span><span>)</span><span style="color: rgb(198, 120, 221);">\)</span><span>,
