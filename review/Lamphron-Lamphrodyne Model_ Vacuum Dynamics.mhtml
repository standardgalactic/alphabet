\section{Math Appendix}
Field equations on flat background:
\begin{align}
\partial_t \rho_m + \nabla \cdot (\rho_m \bm{v}) &amp;= -\kappa \partial_t \Phi, \
\rho_m (\partial_t \bm{v} + \bm{v} \cdot \nabla \bm{v}) &amp;= -\nabla p_m - \rho_m \nabla \varphi - \nabla p_\Phi, \
\nabla^2 \varphi &amp;= 4\pi G \rho_m, \
\partial_t \Phi - D_\Phi \nabla^2 \Phi &amp;= \alpha \sigma_g + \beta \dot{S} - \Gamma \dot{\Phi}, \
p_\Phi &amp;= c_\Phi^2 \Phi \quad (\text{linear EoS near plateau}).
\end{align}
