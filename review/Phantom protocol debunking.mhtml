<p data-start="1897" data-end="1925">with variational potential</p>
<span class="katex-display"><span class="katex"><span class="katex-mathml"><math xmlns="http://www.w3.org/1998/Math/MathML" display="block"><semantics><mrow><mi>F</mi><mo stretchy="false">[</mo><mi mathvariant="normal">Φ</mi><mo separator="true">,</mo><mi mathvariant="bold">v</mi><mo separator="true">,</mo><mi>S</mi><mo stretchy="false">]</mo><mo>=</mo><msub><mo>∫</mo><mi mathvariant="normal">Ω</mi></msub><mo fence="false" stretchy="true" minsize="1.8em" maxsize="1.8em">(</mo><mstyle displaystyle="false" scriptlevel="0"><mfrac><msub><mi>κ</mi><mi mathvariant="normal">Φ</mi></msub><mn>2</mn></mfrac></mstyle><mi mathvariant="normal">∥</mi><mi mathvariant="normal">∇</mi><mi mathvariant="normal">Φ</mi><msup><mi mathvariant="normal">∥</mi><mn>2</mn></msup><mo>+</mo><mstyle displaystyle="false" scriptlevel="0"><mfrac><msub><mi>κ</mi><mi>v</mi></msub><mn>2</mn></mfrac></mstyle><mi mathvariant="normal">∥</mi><mi mathvariant="normal">∇</mi><mo>×</mo><mi mathvariant="bold">v</mi><msup><mi mathvariant="normal">∥</mi><mn>2</mn></msup><mo>+</mo><mstyle displaystyle="false" scriptlevel="0"><mfrac><msub><mi>κ</mi><mi>S</mi></msub><mn>2</mn></mfrac></mstyle><mi mathvariant="normal">∥</mi><mi mathvariant="normal">∇</mi><mi>S</mi><msup><mi mathvariant="normal">∥</mi><mn>2</mn></msup><mo>−</mo><mi>λ</mi><mi mathvariant="normal">Φ</mi><mi>S</mi><mo fence="false" stretchy="true" minsize="1.8em" maxsize="1.8em">)</mo><mtext> </mtext><mi>d</mi><mi>x</mi><mi mathvariant="normal">.</mi></mrow><annotation encoding="application/x-tex">F[\Phi,\mathbf{v},S] = \int_{\Omega}
